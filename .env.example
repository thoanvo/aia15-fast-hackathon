# Copy to .env (repo root) and fill in real values (see src/config/settings.py)

DATABASE_URL=postgresql+psycopg2://<user>:<password>@<neon-host>/<db>?sslmode=require

OPENAI_API_KEY=
# Optional: a separate, SELECT-only Postgres role/connection string for the
# dynamic-SQL agent's query-execution path. Falls back to DATABASE_URL
# (same privileges as the rest of the app) if unset - acceptable for local
# dev only; a real deployment should provision a dedicated read-only role.
READONLY_DATABASE_URL=
# Optional: only set if using an OpenAI-compatible proxy/gateway instead of
# https://api.openai.com/v1 directly (e.g. the workshop's shared gateway).
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Set to false only when pointed at a gateway that needs TLS verification
# disabled (langchain_app/llm.py uses this for httpx.Client(verify=...)).
OPENAI_VERIFY_SSL=false

# LangChain vector store (src/langchain_app/vectorstore).
# Leave unset to use the default (src/langchain_app/vectorstore/index,
# resolved as an absolute path regardless of cwd - see config/settings.py).
VECTOR_STORE_DIR=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Agent loop (src/langchain_app/agent.py) - caps on the tool-calling loop
# per turn. Raise if legitimate multi-tool-call questions hit the cap
# ("Agent stopped due to max iterations."); lower to fail fast instead.
AGENT_MAX_ITERATIONS=30
AGENT_MAX_EXECUTION_TIME_SECONDS=90

# Out-of-scope detection (src/langchain_app/oos_guard.py) - see
# docs/03_functional_and_out_of_scope_requirements.md. Threshold default
# (0.35) is calibrated for EMBEDDING_MODEL_NAME above; recalibrate if you
# change that model (see oos_guard.py's module docstring).
OOS_ENABLED=true
OOS_SIMILARITY_THRESHOLD=0.35
OOS_SECURITY_CHECK_ENABLED=true
OOS_UNCERTAIN_MARGIN=0.10

# Fixed business tools (src/langchain_app/tools/business_tools.py) -
# default true. The dynamic-SQL tools (sql_db_schema/answer_with_sql) are
# always registered regardless of this flag; run_sql_query/answer_with_sql
# executes through READONLY_DATABASE_URL above - point that at a real,
# dedicated read-only Postgres role (not the DATABASE_URL fallback),
# otherwise generated SQL executes with the same privileges as the rest
# of the app, relying on application-level validation alone.
FIXED_TOOLS_ENABLED=true
SQL_AGENT_MAX_ROWS=100
SQL_AGENT_MAX_RETRIES=3

# Frontend only (frontend/api_client.py) - where the backend API is running.
# Optional: defaults to http://127.0.0.1:8000 if unset.
BACKEND_URL=http://127.0.0.1:8000
